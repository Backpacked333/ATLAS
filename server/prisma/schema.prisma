generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Districts & Schools ───────────────────────────────────────────────

model District {
  id        String   @id @default(cuid())
  name      String
  state     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schools School[]
}

model School {
  id         String   @id @default(cuid())
  districtId String
  name       String
  gradeSpan  String   // e.g. "K-5", "6-8", "9-12"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  district      District       @relation(fields: [districtId], references: [id])
  teachers      Teacher[]
  students      Student[]
  sections      Section[]
  counselors    Counselor[]
  notifications Notification[]
  cases         Case[]
  tasks         Task[]
  policyRules   PolicyRule[]
  complianceViolations ComplianceViolation[]
  alertRules    AlertRule[]
  alerts        Alert[]
  integrationConnectors IntegrationConnector[]
  roles         Role[]
  reportDefinitions ReportDefinition[]
  apiKeys       ApiKey[]

  @@index([districtId])
}

// ─── Users ─────────────────────────────────────────────────────────────

model Teacher {
  id            String   @id @default(cuid())
  schoolId      String
  email         String   @unique
  firstName     String
  lastName      String
  ssoProviderId String?  @unique // External SSO identifier
  photoUrl      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school             School              @relation(fields: [schoolId], references: [id])
  sections           TeacherSection[]
  observations       Observation[]
  interventionLogs   InterventionLog[]
  referrals          SSTReferral[]
  parentContacts     ParentContact[]
  notifications      Notification[]
  aiConversations    AIConversation[]
  casesCreated       Case[]              @relation("CasesCreated")
  casesAssigned      Case[]              @relation("CasesAssigned")
  caseNotes          CaseNote[]
  caseActivities     CaseActivity[]
  tasksCreated       Task[]              @relation("TasksCreated")
  tasksAssigned      Task[]              @relation("TasksAssigned")
  alertRulesCreated  AlertRule[]         @relation("AlertRulesCreated")
  roleAssignments    UserRoleAssignment[]
  reportsCreated     ReportDefinition[]  @relation("ReportsCreated")
  deviceRegistrations DeviceRegistration[]
  mobilePreference   MobilePreference?

  @@index([schoolId])
  @@index([email])
}

model Counselor {
  id            String   @id @default(cuid())
  schoolId      String
  email         String   @unique
  firstName     String
  lastName      String
  ssoProviderId String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school   School        @relation(fields: [schoolId], references: [id])
  referrals SSTReferral[]

  @@index([schoolId])
}

// ─── Academic Structure ────────────────────────────────────────────────

model Section {
  id         String   @id @default(cuid())
  schoolId   String
  courseName String   // e.g. "Algebra I"
  period     String   // e.g. "P3"
  semester   String   // e.g. "2025-26 S2"
  room       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  school      School            @relation(fields: [schoolId], references: [id])
  teachers    TeacherSection[]
  enrollments Enrollment[]
  assignments Assignment[]
  seats       SeatAssignment[]

  @@index([schoolId])
}

model TeacherSection {
  id        String @id @default(cuid())
  teacherId String
  sectionId String
  role      String @default("primary") // primary, co-teacher

  teacher Teacher @relation(fields: [teacherId], references: [id])
  section Section @relation(fields: [sectionId], references: [id])

  @@unique([teacherId, sectionId])
  @@index([teacherId])
  @@index([sectionId])
}

// ─── Students ──────────────────────────────────────────────────────────

model Student {
  id          String   @id @default(cuid())
  schoolId    String
  studentIdNo String   @unique // District student ID number
  firstName   String
  lastName    String
  gradeLevel  Int      // K=0, 1-12
  photoUrl    String?
  ellStatus   Boolean  @default(false)
  iepActive   Boolean  @default(false)
  has504      Boolean  @default(false)
  cumulativeGpa Float? // Overall GPA (0.0-4.0)
  totalCredits  Float? // Credits earned
  creditsRequired Float? // Credits needed to be on-track
  riskTier    RiskTier @default(ON_TRACK) // Teacher-visible qualitative label
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school             School              @relation(fields: [schoolId], references: [id])
  enrollments        Enrollment[]
  attendanceRecords  AttendanceRecord[]
  assessmentScores   AssessmentScore[]
  accommodations     Accommodation[]
  observations       Observation[]
  interventions      Intervention[]
  referrals          SSTReferral[]
  parentContacts     ParentContact[]
  grades             Grade[]
  guardians          Guardian[]
  notifications      Notification[]
  cases              Case[]

  @@index([schoolId])
  @@index([studentIdNo])
  @@index([lastName, firstName])
}

enum RiskTier {
  ON_TRACK
  NEEDS_SUPPORT
  URGENT
}

model Guardian {
  id        String  @id @default(cuid())
  studentId String
  firstName String
  lastName  String
  email     String?
  phone     String?
  relation  String  // e.g. "Mother", "Father", "Guardian"
  isPrimary Boolean @default(false)

  student        Student         @relation(fields: [studentId], references: [id])
  parentContacts ParentContact[]

  @@index([studentId])
}

model Enrollment {
  id        String   @id @default(cuid())
  studentId String
  sectionId String
  status    EnrollmentStatus @default(ACTIVE)
  enrollDate DateTime @default(now())
  dropDate   DateTime?

  student Student @relation(fields: [studentId], references: [id])
  section Section @relation(fields: [sectionId], references: [id])

  @@unique([studentId, sectionId])
  @@index([studentId])
  @@index([sectionId])
  @@index([status])
}

enum EnrollmentStatus {
  ACTIVE
  DROPPED
  TRANSFERRED
}

// ─── Grades & Assignments ──────────────────────────────────────────────

model Assignment {
  id          String   @id @default(cuid())
  sectionId   String
  name        String
  category    String   // e.g. "Homework", "Test", "Quiz", "Project"
  pointsPossible Float
  dueDate     DateTime
  createdAt   DateTime @default(now())

  section Section @relation(fields: [sectionId], references: [id])
  grades  Grade[]

  @@index([sectionId])
  @@index([dueDate])
}

model Grade {
  id           String    @id @default(cuid())
  studentId    String
  assignmentId String
  pointsEarned Float?    // null = missing/not submitted
  isMissing    Boolean   @default(false)
  isLate       Boolean   @default(false)
  submittedAt  DateTime?
  gradedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  student    Student    @relation(fields: [studentId], references: [id])
  assignment Assignment @relation(fields: [assignmentId], references: [id])

  @@unique([studentId, assignmentId])
  @@index([studentId])
  @@index([assignmentId])
}

// ─── Attendance ────────────────────────────────────────────────────────

model AttendanceRecord {
  id        String           @id @default(cuid())
  studentId String
  date      DateTime         @db.Date
  period    String?          // null = whole-day, "P3" = period-specific
  status    AttendanceStatus
  createdAt DateTime         @default(now())

  student Student @relation(fields: [studentId], references: [id])

  @@unique([studentId, date, period])
  @@index([studentId, date])
  @@index([date])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  TARDY
  EXCUSED
}

// ─── Assessments ───────────────────────────────────────────────────────

model AssessmentScore {
  id             String   @id @default(cuid())
  studentId      String
  assessmentName String   // e.g. "MAP Reading Fall 2025"
  assessmentType String   // e.g. "MAP", "SBAC", "Illuminate"
  subject        String   // e.g. "Reading", "Math"
  score          Float
  percentile     Int?
  performanceLevel String? // e.g. "Met Standard", "Below Standard"
  testDate       DateTime
  createdAt      DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@index([assessmentType, subject])
}

// ─── Accommodations (504 / IEP) ───────────────────────────────────────

model Accommodation {
  id          String @id @default(cuid())
  studentId   String
  type        AccommodationType
  description String   // e.g. "Extended time 1.5x on all assessments"
  category    String   // e.g. "Testing", "Classroom", "Behavioral"
  isActive    Boolean  @default(true)
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@index([type, isActive])
}

enum AccommodationType {
  IEP
  PLAN_504
}

// ─── Observations (Teacher Notes) ──────────────────────────────────────

model Observation {
  id        String              @id @default(cuid())
  studentId String
  teacherId String
  category  ObservationCategory
  severity  ObservationSeverity
  content   String
  isEditable Boolean            @default(true) // Locked after 24h
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  student Student @relation(fields: [studentId], references: [id])
  teacher Teacher @relation(fields: [teacherId], references: [id])

  @@index([studentId])
  @@index([teacherId])
  @@index([createdAt])
  @@index([severity])
}

enum ObservationCategory {
  ACADEMIC
  BEHAVIORAL
  SOCIAL_EMOTIONAL
  ATTENDANCE
  OTHER
}

enum ObservationSeverity {
  POSITIVE
  CONCERN
  URGENT
}

// ─── Interventions ─────────────────────────────────────────────────────

model Intervention {
  id           String             @id @default(cuid())
  studentId    String
  tier         InterventionTier
  type         String             // e.g. "Daily Check-In", "Tutoring Referral"
  description  String
  teacherRole  String?            // What the teacher specifically does
  startDate    DateTime
  endDate      DateTime?
  status       InterventionStatus @default(ACTIVE)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  student Student           @relation(fields: [studentId], references: [id])
  logs    InterventionLog[]

  @@index([studentId])
  @@index([status])
}

enum InterventionTier {
  TIER_1
  TIER_2
  TIER_3
}

enum InterventionStatus {
  ACTIVE
  COMPLETED
  DISCONTINUED
}

model InterventionLog {
  id              String                @id @default(cuid())
  interventionId  String
  teacherId       String
  date            DateTime              @db.Date
  completionStatus InterventionLogStatus
  notes           String?
  createdAt       DateTime              @default(now())

  intervention Intervention @relation(fields: [interventionId], references: [id])
  teacher      Teacher      @relation(fields: [teacherId], references: [id])

  @@unique([interventionId, teacherId, date])
  @@index([interventionId])
  @@index([teacherId, date])
}

enum InterventionLogStatus {
  COMPLETED
  PARTIALLY_COMPLETED
  NOT_COMPLETED
}

// ─── SST Referrals ─────────────────────────────────────────────────────

model SSTReferral {
  id                String          @id @default(cuid())
  studentId         String
  referringTeacherId String
  assignedCounselorId String?
  primaryConcern    ConcernType
  narrative         String          // Teacher's description (2-3 sentences, max 500 words)
  strategiesAttempted Json           // Array of { strategy: string, date: string }
  urgency           ReferralUrgency
  status            ReferralStatus  @default(PENDING)
  meetingTime       DateTime?
  resolution        String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  student    Student    @relation(fields: [studentId], references: [id])
  teacher    Teacher    @relation(fields: [referringTeacherId], references: [id])
  counselor  Counselor? @relation(fields: [assignedCounselorId], references: [id])

  @@index([studentId])
  @@index([referringTeacherId])
  @@index([assignedCounselorId])
  @@index([status])
}

enum ConcernType {
  ACADEMIC
  BEHAVIORAL
  ATTENDANCE
  SOCIAL_EMOTIONAL
  OTHER
}

enum ReferralUrgency {
  STANDARD  // Review within 5 school days
  URGENT    // Review within 24 hours
}

enum ReferralStatus {
  PENDING
  IN_REVIEW
  MEETING_SCHEDULED
  RESOLVED
  CLOSED
}

// ─── Parent Contact Log ───────────────────────────────────────────────

model ParentContact {
  id         String        @id @default(cuid())
  studentId  String
  teacherId  String
  guardianId String?
  method     ContactMethod
  subject    String
  notes      String
  createdAt  DateTime      @default(now())

  student  Student   @relation(fields: [studentId], references: [id])
  teacher  Teacher   @relation(fields: [teacherId], references: [id])
  guardian Guardian?  @relation(fields: [guardianId], references: [id])

  @@index([studentId])
  @@index([teacherId])
}

enum ContactMethod {
  EMAIL
  PHONE
  IN_PERSON
  OTHER
}

// ─── Seat Assignments ─────────────────────────────────────────────────

model SeatAssignment {
  id        String @id @default(cuid())
  sectionId String
  studentId String?
  row       Int
  col       Int
  label     String? // Optional label like "A1"

  section Section @relation(fields: [sectionId], references: [id])

  @@unique([sectionId, row, col])
  @@index([sectionId])
}

// ─── Notifications ────────────────────────────────────────────────────

model Notification {
  id        String             @id @default(cuid())
  teacherId String?
  schoolId  String?
  studentId String?
  type      NotificationType
  title     String
  body      String
  isRead    Boolean            @default(false)
  channel   NotificationChannel @default(IN_APP)
  createdAt DateTime           @default(now())

  teacher Teacher? @relation(fields: [teacherId], references: [id])
  school  School?  @relation(fields: [schoolId], references: [id])
  student Student? @relation(fields: [studentId], references: [id])

  @@index([teacherId, isRead])
  @@index([createdAt])
}

enum NotificationType {
  ABSENT_STREAK
  GRADE_DROP
  INTERVENTION_ASSIGNED
  INTERVENTION_OVERDUE
  SST_MEETING_SCHEDULED
  NEW_STUDENT
  ACCOMMODATION_REMINDER
}

enum NotificationChannel {
  IN_APP
  EMAIL
  BOTH
}

// ─── Case Management ──────────────────────────────────────────────────

model Case {
  id           String       @id @default(cuid())
  schoolId     String
  studentId    String
  createdById  String
  assignedToId String?
  type         CaseType
  status       CaseStatus   @default(OPEN)
  priority     CasePriority @default(MEDIUM)
  title        String
  description  String
  resolution   String?
  closedAt     DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  school     School      @relation(fields: [schoolId], references: [id])
  student    Student     @relation(fields: [studentId], references: [id])
  createdBy  Teacher     @relation("CasesCreated", fields: [createdById], references: [id])
  assignedTo Teacher?    @relation("CasesAssigned", fields: [assignedToId], references: [id])
  notes      CaseNote[]
  activities CaseActivity[]

  @@index([schoolId])
  @@index([studentId])
  @@index([createdById])
  @@index([assignedToId])
  @@index([status])
  @@index([type])
}

enum CaseType {
  ACADEMIC
  BEHAVIORAL
  ATTENDANCE
  SOCIAL_EMOTIONAL
  SST
  HEALTH
  OTHER
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  PENDING_REVIEW
  ESCALATED
  RESOLVED
  CLOSED
}

enum CasePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model CaseNote {
  id        String   @id @default(cuid())
  caseId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  case   Case    @relation(fields: [caseId], references: [id])
  author Teacher @relation(fields: [authorId], references: [id])

  @@index([caseId])
  @@index([authorId])
}

model CaseActivity {
  id         String   @id @default(cuid())
  caseId     String
  performedById String
  action     String   // e.g. "STATUS_CHANGED", "ASSIGNED", "NOTE_ADDED", "ESCALATED"
  details    String?  // JSON or description of what changed
  createdAt  DateTime @default(now())

  case        Case    @relation(fields: [caseId], references: [id])
  performedBy Teacher @relation(fields: [performedById], references: [id])

  @@index([caseId])
  @@index([performedById])
  @@index([createdAt])
}

// ─── Task Assignment ──────────────────────────────────────────────────

model Task {
  id           String       @id @default(cuid())
  schoolId     String
  createdById  String
  assignedToId String?
  studentId    String?      // Optional link to a student
  caseId       String?      // Optional link to a case
  title        String
  description  String?
  category     TaskCategory
  priority     TaskPriority @default(MEDIUM)
  status       TaskStatus   @default(PENDING)
  dueDate      DateTime?
  completedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  school     School   @relation(fields: [schoolId], references: [id])
  createdBy  Teacher  @relation("TasksCreated", fields: [createdById], references: [id])
  assignedTo Teacher? @relation("TasksAssigned", fields: [assignedToId], references: [id])

  @@index([schoolId])
  @@index([createdById])
  @@index([assignedToId])
  @@index([status])
  @@index([dueDate])
  @@index([category])
}

enum TaskCategory {
  FOLLOW_UP
  PARENT_CONTACT
  DOCUMENTATION
  MEETING
  INTERVENTION
  REFERRAL
  ASSESSMENT
  OTHER
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  OVERDUE
}

// ─── Policy Compliance ────────────────────────────────────────────────

model PolicyRule {
  id          String          @id @default(cuid())
  schoolId    String
  name        String
  description String
  category    PolicyCategory
  isActive    Boolean         @default(true)
  threshold   String?         // JSON threshold config e.g. {"maxAbsences": 10}
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  school     School              @relation(fields: [schoolId], references: [id])
  violations ComplianceViolation[]

  @@index([schoolId])
  @@index([category])
  @@index([isActive])
}

enum PolicyCategory {
  ATTENDANCE
  GRADING
  BEHAVIORAL
  DATA_PRIVACY
  ACCOMMODATION
  REPORTING
}

model ComplianceViolation {
  id           String            @id @default(cuid())
  policyRuleId String
  schoolId     String
  studentId    String?
  teacherId    String?
  severity     ViolationSeverity
  description  String
  status       ViolationStatus   @default(OPEN)
  resolvedById String?
  resolvedAt   DateTime?
  resolution   String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  policyRule PolicyRule @relation(fields: [policyRuleId], references: [id])

  @@index([policyRuleId])
  @@index([schoolId])
  @@index([studentId])
  @@index([teacherId])
  @@index([status])
  @@index([severity])
  @@index([createdAt])
}

enum ViolationSeverity {
  INFO
  WARNING
  CRITICAL
}

enum ViolationStatus {
  OPEN
  ACKNOWLEDGED
  IN_REMEDIATION
  RESOLVED
  DISMISSED
}

// ─── Real-time Alert System ──────────────────────────────────────────

model AlertRule {
  id          String          @id @default(cuid())
  schoolId    String
  createdById String
  name        String
  description String?
  category    AlertCategory
  condition   String          // JSON condition config
  isActive    Boolean         @default(true)
  channels    String          @default("IN_APP") // Comma-separated: IN_APP,EMAIL
  priority    AlertPriority   @default(MEDIUM)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  school    School  @relation(fields: [schoolId], references: [id])
  createdBy Teacher @relation("AlertRulesCreated", fields: [createdById], references: [id])
  alerts    Alert[]

  @@index([schoolId])
  @@index([createdById])
  @@index([category])
  @@index([isActive])
}

enum AlertCategory {
  ATTENDANCE_ALERT
  GRADE_ALERT
  BEHAVIOR_ALERT
  SAFETY_ALERT
  SYSTEM_ALERT
  CUSTOM
}

enum AlertPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Alert {
  id          String        @id @default(cuid())
  alertRuleId String?
  schoolId    String
  teacherId   String?
  studentId   String?
  title       String
  message     String
  priority    AlertPriority @default(MEDIUM)
  channel     String        @default("IN_APP")
  status      AlertStatus   @default(ACTIVE)
  acknowledgedById String?
  acknowledgedAt   DateTime?
  expiresAt   DateTime?
  createdAt   DateTime      @default(now())

  alertRule      AlertRule? @relation(fields: [alertRuleId], references: [id])

  @@index([alertRuleId])
  @@index([schoolId])
  @@index([teacherId])
  @@index([studentId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

enum AlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
  EXPIRED
}

// ─── Data Integration Framework ──────────────────────────────────────

model IntegrationConnector {
  id           String              @id @default(cuid())
  schoolId     String
  name         String
  provider     String              // e.g. "PowerSchool", "Canvas", "Clever"
  type         IntegrationType
  config       String              // Encrypted JSON config (API keys, endpoints)
  isActive     Boolean             @default(true)
  lastSyncAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  school   School         @relation(fields: [schoolId], references: [id])
  syncLogs IntegrationSyncLog[]

  @@index([schoolId])
  @@index([type])
  @@index([isActive])
}

enum IntegrationType {
  SIS       // Student Information System
  LMS       // Learning Management System
  ASSESSMENT // Assessment platforms
  IDENTITY  // SSO / Identity providers
  COMMUNICATION // Parent communication
}

model IntegrationSyncLog {
  id            String      @id @default(cuid())
  connectorId   String
  direction     SyncDirection
  entityType    String      // e.g. "students", "grades", "attendance"
  recordsTotal  Int         @default(0)
  recordsSynced Int         @default(0)
  recordsFailed Int         @default(0)
  status        SyncStatus  @default(IN_PROGRESS)
  errorLog      String?     // JSON array of errors
  startedAt     DateTime    @default(now())
  completedAt   DateTime?

  connector IntegrationConnector @relation(fields: [connectorId], references: [id])

  @@index([connectorId])
  @@index([status])
  @@index([startedAt])
}

enum SyncDirection {
  INBOUND
  OUTBOUND
  BIDIRECTIONAL
}

enum SyncStatus {
  IN_PROGRESS
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

// ─── User Access Control (Module 13) ─────────────────────────────────

model Role {
  id          String   @id @default(cuid())
  schoolId    String
  name        String
  description String?
  isSystem    Boolean  @default(false) // System roles can't be deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School             @relation(fields: [schoolId], references: [id])
  permissions RolePermission[]
  assignments UserRoleAssignment[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Permission {
  id          String   @id @default(cuid())
  resource    String   // e.g. "students", "cases", "reports", "settings"
  action      String   // e.g. "read", "write", "delete", "admin"
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@unique([resource, action])
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserRoleAssignment {
  id        String   @id @default(cuid())
  teacherId String
  roleId    String
  grantedBy String?
  grantedAt DateTime @default(now())
  expiresAt DateTime?

  teacher Teacher @relation(fields: [teacherId], references: [id])
  role    Role    @relation(fields: [roleId], references: [id])

  @@unique([teacherId, roleId])
  @@index([teacherId])
  @@index([roleId])
}

// ─── Audit Logging (Module 14) ──────────────────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  schoolId    String
  userId      String?
  userEmail   String?
  action      String   // e.g. "LOGIN", "VIEW_STUDENT", "CREATE_CASE", "UPDATE_GRADE"
  resource    String   // e.g. "student", "case", "task", "report"
  resourceId  String?
  details     String?  // JSON with additional context
  ipAddress   String?
  userAgent   String?
  status      AuditStatus @default(SUCCESS)
  createdAt   DateTime @default(now())

  @@index([schoolId])
  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@index([status])
}

enum AuditStatus {
  SUCCESS
  FAILURE
  DENIED
}

// ─── Reporting Analytics (Module 15) ─────────────────────────────────

model ReportDefinition {
  id          String       @id @default(cuid())
  schoolId    String
  createdById String
  name        String
  description String?
  type        ReportType
  config      String       // JSON config: filters, columns, grouping
  schedule    String?      // Cron-like schedule for automated reports
  isActive    Boolean      @default(true)
  lastRunAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  school    School          @relation(fields: [schoolId], references: [id])
  createdBy Teacher         @relation("ReportsCreated", fields: [createdById], references: [id])
  snapshots ReportSnapshot[]

  @@index([schoolId])
  @@index([createdById])
  @@index([type])
}

enum ReportType {
  ATTENDANCE_SUMMARY
  GRADE_DISTRIBUTION
  INTERVENTION_PROGRESS
  BEHAVIOR_TRENDS
  COMPLIANCE_STATUS
  STUDENT_RISK
  CUSTOM
}

model ReportSnapshot {
  id                 String   @id @default(cuid())
  reportDefinitionId String
  generatedById      String?
  data               String   // JSON report data
  format             String   @default("JSON") // JSON, CSV, PDF
  recordCount        Int      @default(0)
  generatedAt        DateTime @default(now())

  reportDefinition ReportDefinition @relation(fields: [reportDefinitionId], references: [id])

  @@index([reportDefinitionId])
  @@index([generatedAt])
}

// ─── Mobile Support (Module 16) ──────────────────────────────────────

model DeviceRegistration {
  id          String   @id @default(cuid())
  teacherId   String
  deviceToken String
  platform    DevicePlatform
  deviceName  String?
  isActive    Boolean  @default(true)
  lastActiveAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacher Teacher @relation(fields: [teacherId], references: [id])

  @@unique([teacherId, deviceToken])
  @@index([teacherId])
  @@index([platform])
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

model MobilePreference {
  id                    String  @id @default(cuid())
  teacherId             String  @unique
  pushNotificationsEnabled Boolean @default(true)
  alertSound            Boolean @default(true)
  quietHoursStart       String? // e.g. "22:00"
  quietHoursEnd         String? // e.g. "07:00"
  dataSaverMode         Boolean @default(false)
  offlineCacheEnabled   Boolean @default(true)

  teacher Teacher @relation(fields: [teacherId], references: [id])
}

// ─── API Gateway (Module 17) ────────────────────────────────────────

model ApiKey {
  id          String   @id @default(cuid())
  schoolId    String
  name        String
  keyHash     String   @unique // Hashed API key
  prefix      String   // First 8 chars for identification
  scopes      String   // Comma-separated scopes: "read:students,write:grades"
  isActive    Boolean  @default(true)
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  rateLimitPerMinute Int @default(60)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@index([keyHash])
  @@index([isActive])
}

model ApiRequestLog {
  id          String   @id @default(cuid())
  apiKeyId    String?
  method      String   // GET, POST, PUT, DELETE
  path        String
  statusCode  Int
  responseTime Int     // milliseconds
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([apiKeyId])
  @@index([path])
  @@index([createdAt])
  @@index([statusCode])
}

// ─── Database Architecture (Module 18) ──────────────────────────────

model DatabaseMigration {
  id          String   @id @default(cuid())
  version     String   @unique
  name        String
  description String?
  status      MigrationStatus @default(PENDING)
  appliedAt   DateTime?
  rolledBackAt DateTime?
  checksum    String?
  createdAt   DateTime @default(now())

  @@index([status])
  @@index([appliedAt])
}

enum MigrationStatus {
  PENDING
  APPLIED
  ROLLED_BACK
  FAILED
}

model DatabaseHealthCheck {
  id             String   @id @default(cuid())
  component      String   // e.g. "primary_db", "read_replica", "cache"
  status         HealthStatus
  responseTimeMs Int
  details        String?  // JSON with diagnostic info
  checkedAt      DateTime @default(now())

  @@index([component])
  @@index([status])
  @@index([checkedAt])
}

enum HealthStatus {
  HEALTHY
  DEGRADED
  UNHEALTHY
}

model BackupRecord {
  id          String       @id @default(cuid())
  type        BackupType
  status      BackupStatus @default(IN_PROGRESS)
  sizeBytes   BigInt?
  location    String?     // e.g. S3 path
  startedAt   DateTime    @default(now())
  completedAt DateTime?
  expiresAt   DateTime?
  errorMessage String?

  @@index([type])
  @@index([status])
  @@index([startedAt])
}

enum BackupType {
  FULL
  INCREMENTAL
  SNAPSHOT
}

enum BackupStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
  EXPIRED
}

// ─── Performance Optimization (Module 19) ────────────────────────────

model CacheEntry {
  id          String   @id @default(cuid())
  key         String   @unique
  region      String   // e.g. "query", "session", "page"
  sizeBytes   Int      @default(0)
  hitCount    Int      @default(0)
  missCount   Int      @default(0)
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([region])
  @@index([expiresAt])
}

model PerformanceMetric {
  id             String   @id @default(cuid())
  endpoint       String   // e.g. "/api/students", "/api/briefing"
  method         String   // GET, POST, PUT, DELETE
  avgResponseMs  Float
  p95ResponseMs  Float
  p99ResponseMs  Float
  requestCount   Int      @default(0)
  errorCount     Int      @default(0)
  periodStart    DateTime
  periodEnd      DateTime
  createdAt      DateTime @default(now())

  @@index([endpoint])
  @@index([periodStart])
}

model PerformanceBenchmark {
  id          String   @id @default(cuid())
  name        String
  category    String   // e.g. "query", "api", "render"
  targetMs    Float
  actualMs    Float
  passed      Boolean
  details     String?  // JSON with benchmark details
  runAt       DateTime @default(now())

  @@index([category])
  @@index([runAt])
}

// ─── Disaster Recovery (Module 20) ──────────────────────────────────

model RecoveryPlan {
  id          String              @id @default(cuid())
  name        String
  description String?
  type        RecoveryPlanType
  priority    Int                 @default(1) // 1=highest
  rtoMinutes  Int                 // Recovery Time Objective
  rpoMinutes  Int                 // Recovery Point Objective
  steps       String              // JSON array of recovery steps
  isActive    Boolean             @default(true)
  lastTestedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  tests RecoveryTest[]

  @@index([type])
  @@index([isActive])
}

enum RecoveryPlanType {
  DATABASE_FAILURE
  APPLICATION_FAILURE
  NETWORK_FAILURE
  FULL_SITE_RECOVERY
  DATA_CORRUPTION
  RANSOMWARE
}

model RecoveryTest {
  id             String           @id @default(cuid())
  recoveryPlanId String
  status         RecoveryTestStatus @default(IN_PROGRESS)
  startedAt      DateTime         @default(now())
  completedAt    DateTime?
  durationMs     Int?
  passed         Boolean?
  notes          String?
  issues         String?          // JSON array of issues found

  recoveryPlan RecoveryPlan @relation(fields: [recoveryPlanId], references: [id])

  @@index([recoveryPlanId])
  @@index([status])
  @@index([startedAt])
}

enum RecoveryTestStatus {
  IN_PROGRESS
  PASSED
  FAILED
  ABORTED
}

model FailoverEvent {
  id             String         @id @default(cuid())
  sourceRegion   String
  targetRegion   String
  trigger        String         // "AUTOMATIC" | "MANUAL"
  status         FailoverStatus @default(INITIATED)
  startedAt      DateTime       @default(now())
  completedAt    DateTime?
  durationMs     Int?
  details        String?        // JSON with failover details

  @@index([status])
  @@index([startedAt])
}

enum FailoverStatus {
  INITIATED
  IN_PROGRESS_F // Suffix to avoid Prisma enum conflict
  COMPLETED_F
  FAILED_F
  ROLLED_BACK_F
}

// ─── Encryption Security (Module 21) ────────────────────────────────

model EncryptionKey {
  id          String           @id @default(cuid())
  alias       String           @unique
  algorithm   String           // e.g. "AES-256-GCM", "RSA-2048"
  purpose     KeyPurpose
  status      KeyStatus        @default(ACTIVE)
  rotatedFromId String?
  expiresAt   DateTime?
  createdAt   DateTime         @default(now())
  rotatedAt   DateTime?

  @@index([purpose])
  @@index([status])
  @@index([expiresAt])
}

enum KeyPurpose {
  DATA_ENCRYPTION
  TOKEN_SIGNING
  BACKUP_ENCRYPTION
  TRANSPORT
  API_SIGNING
}

enum KeyStatus {
  ACTIVE
  ROTATED
  REVOKED_KEY
  EXPIRED_KEY
}

model EncryptedField {
  id          String   @id @default(cuid())
  tableName   String
  fieldName   String
  keyAlias    String
  encryptionType String // "AES-256-GCM", "FIELD_LEVEL", "COLUMN_LEVEL"
  createdAt   DateTime @default(now())

  @@unique([tableName, fieldName])
  @@index([keyAlias])
}

model SecurityScan {
  id             String          @id @default(cuid())
  scanType       SecurityScanType
  status         ScanStatus      @default(IN_PROGRESS)
  vulnerabilities Int             @default(0)
  criticalCount  Int             @default(0)
  highCount      Int             @default(0)
  mediumCount    Int             @default(0)
  lowCount       Int             @default(0)
  report         String?         // JSON scan report
  startedAt      DateTime        @default(now())
  completedAt    DateTime?

  @@index([scanType])
  @@index([status])
  @@index([startedAt])
}

enum SecurityScanType {
  VULNERABILITY
  PENETRATION
  COMPLIANCE_SCAN
  ENCRYPTION_AUDIT
  ACCESS_AUDIT
}

enum ScanStatus {
  IN_PROGRESS_S
  COMPLETED_S
  FAILED_S
}

// ─── Multi-Tenancy (Module 22) ──────────────────────────────────────

model Tenant {
  id             String        @id @default(cuid())
  name           String        @unique
  displayName    String
  domain         String?       @unique
  status         TenantStatus  @default(ACTIVE)
  tier           TenantTier    @default(STANDARD)
  maxUsers       Int           @default(100)
  maxStorage     BigInt        @default(5368709120) // 5GB default
  config         String?       // JSON tenant-specific configuration
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  resourceQuotas TenantResourceQuota[]

  @@index([status])
  @@index([tier])
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  PROVISIONING
  DECOMMISSIONED
}

enum TenantTier {
  FREE
  STANDARD
  PREMIUM
  ENTERPRISE
}

model TenantResourceQuota {
  id           String   @id @default(cuid())
  tenantId     String
  resourceType String   // e.g. "api_calls", "storage", "users", "reports"
  limitValue   BigInt
  currentUsage BigInt   @default(0)
  periodStart  DateTime
  periodEnd    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, resourceType, periodStart])
  @@index([tenantId])
  @@index([resourceType])
}

model DataPartition {
  id          String   @id @default(cuid())
  tenantId    String
  tableName   String
  partitionKey String
  rowCount    BigInt   @default(0)
  sizeBytes   BigInt   @default(0)
  lastAnalyzed DateTime?
  createdAt   DateTime @default(now())

  @@unique([tenantId, tableName])
  @@index([tenantId])
}

// ─── Authentication Authorization (Module 23) ────────────────────────

model AuthSession {
  id          String        @id @default(cuid())
  userId      String
  userType    String        // "teacher", "counselor", "admin"
  ipAddress   String?
  userAgent   String?
  isActive    Boolean       @default(true)
  expiresAt   DateTime
  lastActivityAt DateTime  @default(now())
  createdAt   DateTime      @default(now())

  @@index([userId])
  @@index([isActive])
  @@index([expiresAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ipAddress String?
  userAgent String?
  success   Boolean
  failReason String? // "INVALID_CREDENTIALS", "ACCOUNT_LOCKED", "MFA_FAILED"
  createdAt DateTime @default(now())

  @@index([email])
  @@index([ipAddress])
  @@index([createdAt])
  @@index([success])
}

model PasswordPolicy {
  id              String   @id @default(cuid())
  name            String   @unique
  minLength       Int      @default(12)
  requireUppercase Boolean @default(true)
  requireLowercase Boolean @default(true)
  requireNumbers  Boolean  @default(true)
  requireSpecial  Boolean  @default(true)
  maxAgeDays      Int      @default(90)
  historyCount    Int      @default(5) // Can't reuse last N passwords
  lockoutThreshold Int     @default(5)
  lockoutDurationMinutes Int @default(30)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive])
}

model MfaEnrollment {
  id          String   @id @default(cuid())
  userId      String
  method      MfaMethod
  isVerified  Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime?

  @@unique([userId, method])
  @@index([userId])
}

enum MfaMethod {
  TOTP
  SMS
  EMAIL_MFA
  SECURITY_KEY
}

// ─── Backup Recovery (Module 24) ────────────────────────────────────

model ScheduledBackup {
  id          String         @id @default(cuid())
  name        String
  type        BackupType
  schedule    String         // Cron expression: "0 2 * * *"
  isActive    Boolean        @default(true)
  retention   Int            @default(30) // Days to retain
  destination String         // e.g. "s3://backups/atlas/"
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  recoveryPoints RecoveryPoint[]

  @@index([isActive])
  @@index([nextRunAt])
}

model RecoveryPoint {
  id                String         @id @default(cuid())
  scheduledBackupId String?
  type              BackupType
  status            BackupStatus   @default(IN_PROGRESS)
  sizeBytes         BigInt?
  location          String         // Storage path
  checksum          String?        // Integrity verification
  isVerified        Boolean        @default(false)
  retainUntil       DateTime?
  createdAt         DateTime       @default(now())
  completedAt       DateTime?
  errorMessage      String?

  scheduledBackup ScheduledBackup? @relation(fields: [scheduledBackupId], references: [id])

  @@index([scheduledBackupId])
  @@index([type])
  @@index([status])
  @@index([retainUntil])
}

model RetentionPolicy {
  id            String   @id @default(cuid())
  name          String   @unique
  backupType    BackupType
  retentionDays Int
  maxCopies     Int      @default(10)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([backupType])
  @@index([isActive])
}

// ─── Monitoring Alerting (Module 25) ─────────────────────────────────

model SystemMetric {
  id         String   @id @default(cuid())
  name       String   // e.g. "cpu_usage", "memory_usage", "disk_usage", "active_connections"
  value      Float
  unit       String   // e.g. "percent", "bytes", "count", "ms"
  host       String   @default("primary")
  tags       String?  // JSON key-value tags
  recordedAt DateTime @default(now())

  @@index([name])
  @@index([host])
  @@index([recordedAt])
}

model ServiceHealth {
  id           String              @id @default(cuid())
  serviceName  String              // e.g. "api", "database", "cache", "queue"
  status       ServiceHealthStatus @default(HEALTHY)
  responseMs   Int?
  errorMessage String?
  metadata     String?             // JSON additional health info
  checkedAt    DateTime            @default(now())

  @@index([serviceName])
  @@index([status])
  @@index([checkedAt])
}

enum ServiceHealthStatus {
  HEALTHY_S
  DEGRADED_S
  UNHEALTHY_S
  UNREACHABLE
}

model MonitoringDashboard {
  id          String   @id @default(cuid())
  name        String
  description String?
  layout      String   // JSON widget layout configuration
  isDefault   Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isDefault])
  @@index([createdById])
}

model MonitoringAlert {
  id           String               @id @default(cuid())
  name         String
  metricName   String
  condition    String               // e.g. "> 90", "< 10", "== 0"
  threshold    Float
  severity     MonitoringAlertSeverity @default(WARNING_M)
  isActive     Boolean              @default(true)
  lastTriggeredAt DateTime?
  cooldownMinutes Int               @default(15)
  notifyChannels  String            @default("IN_APP") // Comma-separated
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  incidents MonitoringIncident[]

  @@index([metricName])
  @@index([isActive])
}

enum MonitoringAlertSeverity {
  INFO_M
  WARNING_M
  CRITICAL_M
}

model MonitoringIncident {
  id                String           @id @default(cuid())
  monitoringAlertId String
  status            IncidentStatus   @default(OPEN_I)
  metricValue       Float
  message           String
  acknowledgedById  String?
  acknowledgedAt    DateTime?
  resolvedAt        DateTime?
  createdAt         DateTime         @default(now())

  monitoringAlert MonitoringAlert @relation(fields: [monitoringAlertId], references: [id])

  @@index([monitoringAlertId])
  @@index([status])
  @@index([createdAt])
}

enum IncidentStatus {
  OPEN_I
  ACKNOWLEDGED_I
  RESOLVED_I
}

// ─── AI Conversations ─────────────────────────────────────────────────

model AIConversation {
  id        String   @id @default(cuid())
  teacherId String
  studentId String?  // Optional: if conversation is about a specific student
  createdAt DateTime @default(now())

  teacher  Teacher        @relation(fields: [teacherId], references: [id])
  messages AIMessage[]

  @@index([teacherId])
}

model AIMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String   // "user" or "assistant"
  content        String
  createdAt      DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
}
